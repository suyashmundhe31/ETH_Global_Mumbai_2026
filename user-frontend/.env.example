# Copy to user-frontend/.env.local (git-ignored). Next.js loads it at `npm run dev` / `npm run build`.
# NEXT_PUBLIC_* values are embedded in the browser bundle: public values only. Contract addresses,
# networks and the settler address come from the worker (WORKER_URL), so they are not repeated here.

# --- World ID (https://developer.world.org) ---
# App ID of your World ID app (starts with app_)
NEXT_PUBLIC_WORLD_APP_ID=
# Relying-party ID used for request signing and proof verification
NEXT_PUBLIC_WORLD_RP_ID=
# production | staging (staging = the World ID simulator)
NEXT_PUBLIC_WORLD_ENV=production
# SECRET (server only): RP signing key (hex). Signs World ID requests and is the base of the session-cookie /
# wallet-challenge HMACs (lib/session.ts).
RP_SIGNING_KEY=

# --- Mapbox (https://account.mapbox.com) ---
# Public access token (pk.…)
NEXT_PUBLIC_MAPBOX_TOKEN=
# Style URL, e.g. mapbox://styles/<user>/<style-id>
NEXT_PUBLIC_MAPBOX_STYLE=

# --- Backend ---
# The worker's HTTP API (server-side only; never sent to the browser)
WORKER_URL=http://localhost:8787
# SECRET (server only): signs the claim tickets CreatureMarket requires (proof the claimer is a World ID verified
# human). Its address is CreatureMarket.humanSigner. Generate with: npm --prefix worker run gen-key -- HUMAN_SIGNER
# (needs no funds).
HUMAN_SIGNER_PRIVATE_KEY=
