# Copy to user-frontend/.env.local (git-ignored). Next.js loads it at `npm run dev` / `npm run build`.
# NEXT_PUBLIC_* values are embedded in the browser bundle: public values only.

# --- World ID (https://developer.world.org) ---
# App ID of your World ID app (starts with app_)
NEXT_PUBLIC_WORLD_APP_ID=
# Relying-party ID used for request signing and proof verification
NEXT_PUBLIC_WORLD_RP_ID=
# production | staging
NEXT_PUBLIC_WORLD_ENV=production
# SECRET (server only, never NEXT_PUBLIC): RP signing key (hex). Signs World ID requests and is the base
# of the session-cookie / wallet-challenge HMACs (lib/session.ts).
RP_SIGNING_KEY=

# --- Mapbox (https://account.mapbox.com) ---
# Public access token (pk.…)
NEXT_PUBLIC_MAPBOX_TOKEN=
# Style URL, e.g. mapbox://styles/<user>/<style-id>
NEXT_PUBLIC_MAPBOX_STYLE=

# --- Chain + Arkiv reads (public) ---
# Base Sepolia RPC for reads (optional; without it several public RPCs are tried in turn)
NEXT_PUBLIC_BASE_SEPOLIA_RPC=
# Arkiv access key (not a secret; without one the public Rabdi endpoint is heavily rate limited)
NEXT_PUBLIC_ARKIV_ACCESS_KEY=
# Swarm gateway for creature GLBs (optional, default https://download.gateway.ethswarm.org)
NEXT_PUBLIC_SWARM_GATEWAY=

# --- Backend ---
# The worker's HTTP API (server-side only; never sent to the browser). Needed for listing attestations and
# discount-code reveals. Without it, /api/config falls back to the Base Sepolia deployment below (map,
# collection and marketplace still work; selling and redeeming do not).
WORKER_URL=http://localhost:8787
# SECRET (server only): signs the claim tickets CreatureMarket requires (proof the claimer is a World ID verified
# human). Its address must be CreatureMarket.humanSigner (0xA9cf0686cFfa333FC9FAe032A973F8eFa849E51B).
HUMAN_SIGNER_PRIVATE_KEY=
# Optional overrides of the fallback deployment (used only when WORKER_URL is empty):
# CHAIN_ID=84532
# CAMPAIGN_MANAGER_ADDRESS=0xF0Cbd7c4F16C62f12196FF2Bd6ff7cc733d18F83
# CREATURE_MARKET_ADDRESS=0x7bb39cc991aF6558fbD15aaee401acD58222e4b3
# SETTLER_ADDRESS=0x84aAd29baB0668fC7DdF227f0f68e37a7142672b
