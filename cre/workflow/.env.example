# Copy to cre/workflow/.env (gitignored).
# Pays gas for `cre workflow simulate --broadcast` (the MockKeystoneForwarder call). A funded dev key, not the deployer.
CRE_ETH_PRIVATE_KEY=
BASE_SEPOLIA_RPC=https://sepolia.base.org
# AES-256 key (base64, 32 bytes) the business app encrypts discount codes with (same as the friend's CODE_ENCRYPTION_KEY).
CODE_ENCRYPTION_KEY_ALL=
# X25519 secret key (hex, 32 bytes) the workflow seals codes with. Its public key is the frontend's
# NEXT_PUBLIC_WORKFLOW_BOX_PUBKEY. Generate both with the command in ../README.md.
WORKFLOW_BOX_SK_ALL=
