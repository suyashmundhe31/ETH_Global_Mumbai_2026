# Copy to frontend/.env.local. Only PUBLIC values: everything VITE_* is embedded in the browser bundle.
# Never put private keys or API secrets here.

# Worker API
VITE_API_URL=http://localhost:8787

# Chain + contract. Leave empty to use the worker's /api/config (reads contracts/deployments/<chainId>.json).
VITE_CHAIN_ID=
VITE_CHAIN_NAME=
VITE_RPC_URL=
VITE_BLOCK_EXPLORER_URL=
VITE_CAMPAIGN_MANAGER_ADDRESS=

# No Arkiv access key belongs here: it would ship in the browser bundle. When the page adds the
# Arkiv network to MetaMask it uses the public RPC; a business that hits rate limits can edit that
# network in MetaMask to use its own key (https://hub.arkiv.network/access-keys).
