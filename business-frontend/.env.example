# Copy to frontend/.env.local. Only PUBLIC values: everything VITE_* is embedded in the browser bundle.
# Never put private keys or API secrets here.

# Worker API
VITE_API_URL=http://localhost:8787

# Chain + contract. Leave empty to use the worker's /api/config (reads contracts/deployments/<chainId>.json).
VITE_CHAIN_ID=
VITE_CHAIN_NAME=
VITE_RPC_URL=
VITE_BLOCK_EXPLORER_URL=
VITE_CAMPAIGN_MANAGER_ADDRESS=

# Optional Arkiv access key for the RPC URL MetaMask uses when the page adds the Arkiv network.
# Arkiv access keys are not secrets (they ship with any app, per the SDK docs) — restrict this one
# to your site's origins at https://hub.arkiv.network/access-keys. Empty = public, rate-limited RPC.
VITE_ARKIV_ACCESS_KEY=
