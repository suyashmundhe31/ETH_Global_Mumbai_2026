contracts/broadcast/*/31337/
contracts/broadcast/*/31338/
contracts/deployments/31337.json
contracts/deployments/31338.json
# simulations and lock files are never needed
contracts/broadcast/**/dry-run/
*.recovery.lock
deployments

# ---------------------------------------------------------------- logs / tests / tooling
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
coverage/
.vercel
.cache/
.turbo/
.claude

