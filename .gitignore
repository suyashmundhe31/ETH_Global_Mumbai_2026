node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------- build output
# user-frontend (Next.js)
.next/
out/
build/
# business-frontend (Vite)
dist/
.vite/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------- environment variables / secrets
.env
.env.*
*.env
!.env.example
*.pem
signing-key-*.json

# ---------------------------------------------------------------- runtime data
# user-frontend: World ID nullifier <-> wallet store
players.json
# worker: Arkiv / Swarm progress journal
worker/data/*.json
worker/data/tmp/

# ---------------------------------------------------------------- contracts (Foundry)
contracts/out/
contracts/cache/
