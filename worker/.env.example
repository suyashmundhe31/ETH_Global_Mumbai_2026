# --- HTTP API ---
PORT=8787
# Comma separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ASSETS_DIR=../assets/creatures
MAX_GLB_BYTES=10485760
STATE_FILE=./data/state.json

# --- Campaign chain ---
CHAIN_ID=31337
CHAIN_RPC_URL=http://127.0.0.1:8545
# RPC URL handed to the browser (MetaMask "add network"). Must NOT contain an API key.
# Empty = CHAIN_RPC_URL when it is a local node, otherwise nothing is exposed.
PUBLIC_RPC_URL=
# Optional. If empty, read from ../contracts/deployments/<CHAIN_ID>.json (written by the deploy scripts)
CAMPAIGN_MANAGER_ADDRESS=
START_BLOCK=
CONFIRMATIONS=0
POLL_INTERVAL_MS=3000
# Max blocks per eth_getLogs call. Public RPCs cap this (https://sepolia.base.org allows 200).
LOG_RANGE=2000

# --- VRF ---
# mock      = local Anvil only: the worker plays the Chainlink node against VRFCoordinatorV2_5Mock
# chainlink = testnet/mainnet: the real Chainlink VRF service fulfils requests (worker only listens)
# Empty = taken from the deployment file.
VRF_MODE=
VRF_COORDINATOR_ADDRESS=
# mock mode only: any funded LOCAL account (e.g. an Anvil dev account). Never a real key.
LOCAL_VRF_FULFILLER_PRIVATE_KEY=
LOCAL_VRF_FULFILL_DELAY_MS=2000

# --- Swarm ---
# Own Bee node (recommended, durable): SWARM_BEE_URL=http://localhost:1633 + SWARM_POSTAGE_BATCH_ID=<usable batch id>
# Public gateway (dev/demo only): SWARM_BEE_URL=https://api.gateway.ethswarm.org and leave the batch empty
SWARM_BEE_URL=https://api.gateway.ethswarm.org
SWARM_POSTAGE_BATCH_ID=
SWARM_VERIFY_DOWNLOAD=true
SWARM_PIN=false

# --- Discount code encryption (AES-256-GCM) ---
# 32 random bytes, base64. Generate with:  npm --prefix worker run gen-code-key
# Server-side only (never put it in the frontend). Back it up: codes encrypted with it cannot be
# decrypted without it, and changing it makes existing campaigns' codes unreadable.
CODE_ENCRYPTION_KEY=

# --- Arkiv ---
# The worker only READS Arkiv (prepare + verify). The BUSINESS signs the creature entities in
# MetaMask, so Arkiv records the business wallet as $creator and $owner. No Arkiv key here.
ARKIV_NETWORK=rabdi
# Free key from https://hub.arkiv.network/access-keys (empty = public, heavily rate limited endpoint)
ARKIV_ACCESS_KEY=
ARKIV_SCHEMA_NAME=ethglobal-mumbai-2026.creature.v2
# Creatures per business-signed Arkiv transaction = one MetaMask confirmation per batch
# (each transaction is atomic only for its own batch).
ARKIV_BATCH_SIZE=10
ARKIV_EXPLORER_URL=https://rabdi.explorer.arkiv.network
