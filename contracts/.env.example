# --- RPC endpoints ---
LOCAL_RPC_URL=http://127.0.0.1:8545
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# --- Deployer ---
# For local Anvil you may use Anvil's publicly-known test account #0 key (printed by `anvil` on start).
# For testnets use a dedicated throwaway key funded with test ETH.
DEPLOYER_PRIVATE_KEY=

# --- Chainlink VRF v2.5 (testnet) ---
# Values for your network: https://docs.chain.link/vrf/v2-5/supported-networks
# Ethereum Sepolia:
#   VRF_COORDINATOR=0x9DdfaCa8183c41ad55329BdeeD9F6A8d53168B1B
#   VRF_KEY_HASH=0x787d74caea10b2b357790d5b5247c2f63d1d91572a9846f780606e4d953677ae
VRF_COORDINATOR=
VRF_KEY_HASH=
# Create + fund at https://vrf.chain.link (subscription IDs are uint256)
VRF_SUBSCRIPTION_ID=
VRF_REQUEST_CONFIRMATIONS=3
VRF_CALLBACK_GAS_LIMIT=2000000
# true = pay in native ETH, false = pay in LINK
VRF_NATIVE_PAYMENT=false
# true only if the deployer key owns the subscription (otherwise add the consumer in the VRF UI)
VRF_ADD_CONSUMER=false
